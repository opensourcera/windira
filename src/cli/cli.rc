#include <winres.h>
#include "../common/version.h"

1 ICON "../../res/windira.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WINDIRA_VERSION_NUM
 PRODUCTVERSION WINDIRA_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "opensourcera"
            VALUE "FileDescription", "Windira command line - rename devices"
            VALUE "FileVersion", WINDIRA_VERSION_STR
            VALUE "InternalName", "windira-cli"
            VALUE "LegalCopyright", WINDIRA_COPYRIGHT
            VALUE "OriginalFilename", "windira-cli.exe"
            VALUE "ProductName", "Windira"
            VALUE "ProductVersion", WINDIRA_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
